%% techbrief.sty -- ACM TechBrief layout on top of the unmodified acmart class.
%%
%% Usage:
%%   \documentclass[acmlarge,nonacm,natbib=false]{acmart}
%%   \usepackage{techbrief}
%%   \addbibresource{refs.bib}
%%   ...
%%   \maketechbrief
%%   \begin{techbriefbody} ... \end{techbriefbody}
%%   \techbriefbackpage
%%   \printbibliography
%%
%% See techbrief-sample.tex for the full set of commands.
%%
%% Compile with LuaLaTeX (or XeLaTeX); the layout needs OpenType fonts.
%%
%% All dimensions are in big points (bp, 1/72in) because they were
%% measured from the published PDF (Issue 18, doi:10.1145/3819832).
%%
%% Free stand-ins for the original typefaces:
%%   Arnhem (body, headings, table)  -> Source Serif Pro
%%   Verdana (banner, running head)  -> DejaVu Sans
%%   Myriad Pro (footer, logo text)  -> Source Sans Pro
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{techbrief}[2026/10/06 v1.0 ACM TechBrief layout for acmart]

\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{techbrief}{Please compile with LuaLaTeX or XeLaTeX}
    {The TechBrief layout uses OpenType fonts through fontspec.}
\fi

\RequirePackage{fontspec}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{ccicons}
\@ifpackageloaded{natbib}{%
  \PackageError{techbrief}{Load acmart with the natbib=false option}
    {TechBriefs use biblatex (acmart's acmnumeric style) so that
     references appear in citation order.}}{}
\RequirePackage[datamodel=acmdatamodel,style=acmnumeric,
  sorting=none,autocite=superscript,maxbibnames=99]{biblatex}

%% ---------------------------------------------------------------------
%% Colours (from the original's CMYK separations, as rendered RGB).
\definecolor{tbnavy}{HTML}{004278}   % banners, headings, footer text
\definecolor{tbblue}{HTML}{005697}   % title strip, table header
\definecolor{tbsky}{HTML}{71CEF5}    % "Briefs", logo diamond on navy
\definecolor{tbpale}{HTML}{E2F4FD}   % footer panels
\definecolor{tbink}{HTML}{231F20}    % text and rules
\definecolor{tblogoblue}{HTML}{0093D0}
\definecolor{tblogodeep}{HTML}{005EAB}

%% ---------------------------------------------------------------------
%% Fonts.
%%
%% The layout is calibrated against Source Serif Pro and Source Sans Pro.
%% TeX Live 2026 replaced those with Source Serif 4 and Source Sans 3
%% (new file names, different metrics), so the exact fonts ship in the
%% fonts/ directory next to this file.  They are looked up in order:
%%   1. \techbrieffontdir (default fonts/), the bundled copies;
%%   2. an installed Source Serif Pro / Source Sans Pro (TeX Live <= 2025);
%%   3. an installed Source Serif 4 / Source Sans 3, with a warning that
%%      line breaks will differ from the published TechBrief.
%% Define \techbrieffontdir before \usepackage{techbrief} to move fonts/.
\providecommand\techbrieffontdir{fonts/}
\IfFileExists{\techbrieffontdir SourceSerifPro-Regular.otf}
  {\edef\tb@fontopts{Path=\techbrieffontdir,}%
   \def\tb@serif{SourceSerifPro}\def\tb@sans{SourceSansPro}}
  {\def\tb@fontopts{}%
   \IfFontExistsTF{SourceSerifPro-Regular.otf}
     {\def\tb@serif{SourceSerifPro}\def\tb@sans{SourceSansPro}}
     {\def\tb@serif{SourceSerif4}\def\tb@sans{SourceSans3}%
      \PackageWarningNoLine{techbrief}{The bundled fonts in
        \techbrieffontdir\space were not found;\MessageBreak
        using Source Serif 4 and Source Sans 3 instead.\MessageBreak
        Line breaks will differ from the published TechBrief}}}
\edef\tb@loadfonts{%
  \noexpand\setmainfont{\tb@serif}[\tb@fontopts
    Extension=.otf,
    UprightFont=*-Regular, ItalicFont=*-RegularIt,
    BoldFont=*-Bold, BoldItalicFont=*-BoldIt,
    LetterSpace=-0.5, Numbers=Lining]%
  \noexpand\setsansfont{\tb@sans}[\tb@fontopts
    Extension=.otf,
    UprightFont=*-Regular, ItalicFont=*-RegularIt,
    BoldFont=*-Semibold, BoldItalicFont=*-SemiboldIt]%
  \noexpand\newfontfamily\noexpand\tb@black{\tb@serif-Black.otf}[%
    \tb@fontopts Numbers=Lining]%
  \noexpand\newfontfamily\noexpand\tb@myriad{\tb@sans}[\tb@fontopts
    Extension=.otf, UprightFont=*-Regular, BoldFont=*-Semibold]}
\tb@loadfonts
\newfontfamily\tb@verdana{DejaVuSans}[
  Extension=.ttf, UprightFont=*, BoldFont=*-Bold]
\newfontfamily\tb@verdanacaps{DejaVuSans-Bold.ttf}[LetterSpace=4.7]

\renewcommand\normalsize{\@setfontsize\normalsize{10bp}{11.5bp}}
\newcommand\tb@tablesize{\fontsize{9bp}{10.5bp}\selectfont}
\newcommand\tb@bibsize{\fontsize{7bp}{7.25bp}\selectfont}
\newcommand\tb@smallprint{\fontsize{8bp}{8.75bp}\selectfont
  \lineskiplimit=-\maxdimen}

%% ---------------------------------------------------------------------
%% Page geometry: the body sits in a ruled frame 540bp wide, 84.1bp from
%% the top (below the running banner) and 48.1bp from the bottom.
\geometry{reset,paperwidth=612bp,paperheight=792bp,
  left=36bp,right=36bp,top=84.1bp,bottom=48.1bp,
  nohead,nofoot,nomarginpar}

\def\ps@techbrief{\let\@oddhead\@empty\let\@evenhead\@empty
  \let\@oddfoot\@empty\let\@evenfoot\@empty}

\setlength\parindent{0pt}
\setlength\parskip{4bp}
\urlstyle{same}
\AtBeginDocument{%
  \pagestyle{techbrief}%
  \setlength\parindent{0pt}%
  \setlength\parskip{4bp}%
  \hypersetup{hidelinks}%
  \color{tbink}}

%% ---------------------------------------------------------------------
%% Issue metadata.
\newcommand\tb@season{Season Year}
\newcommand\tb@issue{N}
\newcommand\techbriefissue[2]{\def\tb@season{#1}\def\tb@issue{#2}}
\newcommand\tb@ack{}
