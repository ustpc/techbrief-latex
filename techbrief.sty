\newcommand\tb@url{acm.org/public-policy/techbriefs}

%% "A, B, and C" from acmart's \authors list ("A\and B\and C").
\ExplSyntaxOn
\seq_new:N \l__techbrief_authors_seq
\cs_new_protected:Npn \tb@byline
  {
    \seq_set_split:NnV \l__techbrief_authors_seq { \and } \authors
    \seq_use:Nnnn \l__techbrief_authors_seq
      { ~and~ } { ,~ } { ,~and~ }
  }
\tl_new:N \l__techbrief_pdfauthor_tl
\cs_new_protected:Npn \tb@setpdfauthor
  {
    \seq_set_split:NnV \l__techbrief_authors_seq { \and } \authors
    % hyperxmp splits pdfauthor at commas into the XMP author list.
    \tl_set:Ne \l__techbrief_pdfauthor_tl
      { \seq_use:Nn \l__techbrief_authors_seq { ,~ } }
    \exp_args:Ne \hypersetup
      { pdfauthor = { \exp_not:V \l__techbrief_pdfauthor_tl } }
  }
\ExplSyntaxOff

