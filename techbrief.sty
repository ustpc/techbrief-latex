%% acmart warns about every \vspace, so the layout uses these copies of
%% LaTeX's own \vspace and \vspace* (vertical mode only).
\newcommand\tb@vspace[1]{\vskip#1\vskip\z@skip}
\newcommand\tb@vspacestar[1]{\par\dimen@\prevdepth\hrule\@height\z@
  \nobreak\vskip#1\vskip\z@skip\prevdepth\dimen@}

%% ---------------------------------------------------------------------
%% Title page and body frame.
%%
%% \maketechbrief    paints the banner on this page and reserves its space
%% techbriefbody     the ruled frame around the main text (breakable)
\newcommand\maketechbrief{%
  \thispagestyle{techbrief}%
  \global\tb@titlepagetrue
  \pdfstringdefDisableCommands{\def\\{ }}%
  \hypersetup{pdftitle={\@title}}\tb@setpdfauthor
  \enlargethispage{-58.6bp}%
  \tb@vspacestar{\dimexpr 220.7bp-84.1bp-\topskip+\baselineskip\relax}%
  \par\tb@vspace{-\baselineskip}}

% The frame is stroked (as in the original) and closed on every page.
\newtcolorbox{techbriefbody}{breakable,enhanced,
  sharp corners,boxrule=0.25bp,frame hidden,colback=white,
  overlay={\draw[tbink,line width=0.25bp]
    ([shift={(0.1bp,0bp)}]frame.south west) rectangle
    ([shift={(-0.1bp,0bp)}]frame.north east);},
  boxsep=0pt,left=11.95bp,right=9.95bp,top=11.5bp,bottom=9.3bp,
  height fixed for=first and middle,height fill,
  before skip=0pt,after skip=0pt,
  before upper={\setlength\parskip{4bp}\setlength\parindent{0pt}},
  parbox=false}

%% ---------------------------------------------------------------------
%% Headings.
%% acmart forbids redefining \section, so only its font hook is changed.
%% The heading's baseline is set by its 12.4bp \baselineskip (the
%% \lineskiplimit change stops a tall heading after ordinary text from
%% falling back to \lineskip), and \tb@afterhead brings the following
%% text to the original's 14.5bp baseline-to-baseline distance.  acmart
%% runs \@secfont twice, so each call contributes half of the -3.9bp.
\def\@secfont{\tb@black\fontsize{14bp}{12.4bp}\selectfont\color{tbnavy}%
  \ifvmode\ifdim\prevdepth<4bp \lineskiplimit=-\maxdimen\fi\fi
  \section@raggedright\aftergroup\tb@afterhead}
\def\tb@afterhead{\nobreak\vskip-1.95bp
  \ifdim\prevdepth>0pt \vskip-\prevdepth\prevdepth=0pt\fi}
\setcounter{secnumdepth}{0}

% Run-in bold head: \runinhead{Legal Responsibility and Liability.}
\newcommand\runinhead[1]{\textbf{#1}\space\ignorespaces}

% Italic summary paragraph; optional argument indents it (e.g. 12bp).
\newenvironment{takeaway}[1][0bp]
  {\par\leftskip=#1\relax\itshape}{\par}

%% ---------------------------------------------------------------------
%% Lists: navy 14bp bold bullets (sitting 1bp below the baseline, as in
%% the original), text indented 12bp.
\newcommand\tb@bullet{\raisebox{-1bp}{\textcolor{tbnavy}{%
  \fontsize{14bp}{0}\selectfont\bfseries\symbol{"2022}}}}
\setlist[itemize,1]{label=\tb@bullet,
  leftmargin=12bp,labelwidth=12bp,labelsep=0pt,align=left,
  topsep=12bp,partopsep=0pt,itemsep=4bp,parsep=0pt,
  after=\tb@vspace{-4bp}}
\setlist[itemize,2]{label=\tb@bullet,
  leftmargin=11.5bp,labelwidth=11.5bp,labelsep=0pt,align=left,
  topsep=4bp,partopsep=0pt,itemsep=4bp,parsep=0pt}

%% ---------------------------------------------------------------------
%% Tables: a non-floating table (floats cannot live inside the frame).
%%   \begin{techbrieftable}{Caption}{L{115.3bp}L{171.7bp}...}
%%     \rowcolor{tbblue} & \tbhead{A} & \tbhead{B} \tbheadend
%%     \tbrowhead{Row} & ... & ... \\
%%   \end{techbrieftable}
% Ragged-right column whose width includes a 6bp gutter on its right
% (kept inside the cell so that \rowcolor covers it).
\newcolumntype{L}[1]{>{\raggedright\rightskip=6bp plus 1fil
  \arraybackslash}p{#1}}
\DeclareCaptionLabelSeparator{tbcolon}{:\hspace{3.6bp}}
\captionsetup[table]{hypcap=false,labelfont={rm,bf,normalsize,color=tbblue},
  textfont={rm,bf,normalsize},
  labelsep=tbcolon,justification=raggedright,singlelinecheck=false,
  skip=3.2bp,position=top}
\newenvironment{techbrieftable}[2]
  {\par\tb@vspace{6.2bp}\noindent
   \begin{minipage}{\linewidth}%
   \captionof{table}{#1}%
   \tb@tablesize\setlength\tabcolsep{0pt}%
   \setlength\extrarowheight{1.9bp}%
   \arrayrulecolor{tbink}\setlength\arrayrulewidth{0.8bp}%
   \begin{tabular}{#2}\hline}
  {\noalign{\vskip 3.9bp}\hline\end{tabular}\end{minipage}\par}
% Header cell: white Black-weight text on the 18.9bp blue band; end the
% header row with \tbheadend rather than \\.
\newcommand\tbheadend{\\\noalign{\vskip 2.65bp}}
\newcommand\tbhead[1]{\rule[-6.8bp]{0pt}{18.9bp}%
  \textcolor{white}{\tb@black #1}}
\newcommand\tbrowhead[1]{\textbf{#1}}

%% Figures: likewise non-floating, with the same caption style.
%%   \begin{techbrieffigure}{Caption}
%%     \includegraphics[width=\linewidth]{diagram.pdf}
%%   \end{techbrieffigure}
\captionsetup[figure]{hypcap=false,name=Figure,
  labelfont={rm,bf,normalsize,color=tbblue},textfont={rm,bf,normalsize},
  labelsep=tbcolon,justification=raggedright,singlelinecheck=false,
  skip=3.2bp,position=top}
\newenvironment{techbrieffigure}[1]
  {\par\tb@vspace{6.2bp}\noindent
   \begin{minipage}{\linewidth}%
   \captionof{figure}{#1}\centering}
  {\end{minipage}\par\tb@vspace{4bp}}

%% ---------------------------------------------------------------------
%% Back page: references, plus the information panel at the foot.
%% References are numbered in citation order and cited as superscripts.
\newcounter{tb@backpage}
\newcommand\techbriefbackpage{%
  \clearpage\global\tb@backpagetrue\setcounter{tb@backpage}{\value{page}}}
% The panel starts 577.2bp down the page; the references must stay above it.
\newcommand\tb@checkbackpage{%
  \ifnum\value{page}>\value{tb@backpage}%
    \PackageWarningNoLine{techbrief}{The references run past the back
      page.\MessageBreak Shorten them or remove some}%
  \else\ifdim\pagetotal>480bp
    \PackageWarningNoLine{techbrief}{The references overlap the
      Additional\MessageBreak Information panel on the back page}%
  \fi\fi}

\renewcommand*\supercitedelim{,}
% Superscript citations as in the original: 5.83bp figures raised 3.3bp,
% smashed so that they never open up the line spacing.
\renewrobustcmd*\mkbibsuperscript[1]{\unspace\smash{\raisebox{3.3bp}{%
  \fontsize{5.83bp}{0}\selectfont #1}}}
\AtBeginDocument{\let\cite\supercite}
\DeclareFieldFormat{labelnumberwidth}{#1}
% Keep titles as entered, print DOIs as resolvable URLs, and break URLs
% only at punctuation such as `/', as the original does.
\DeclareFieldFormat{titlecase}{#1}
\DeclareFieldFormat{doi}{\url{https://doi.org/#1}}
\setcounter{biburlnumpenalty}{0}
\setcounter{biburlucpenalty}{0}
\setcounter{biburllcpenalty}{0}
% acmnumeric.bbx sets \bibfont when biblatex loads it, so override later.
\AtBeginDocument{\renewcommand*\bibfont{\tb@bibsize}}
\defbibheading{bibliography}[\refname]{%
  \tb@vspacestar{-16.3bp}%
  {\centering\tb@heading{#1}\par}%
  \tb@vspace{4.8bp}}
\defbibenvironment{bibliography}
  {\list{\printfield[labelnumberwidth]{labelnumber}}
     {\setlength\labelwidth{9.1bp}\setlength\labelsep{4.7bp}%
      \setlength\leftmargin{13.8bp}\setlength\itemsep{0pt}%
      \setlength\parsep{0pt}\setlength\topsep{0pt}%
      \setlength\partopsep{0pt}%
      \renewcommand*\makelabel[1]{\hss##1}}%
   \sloppy\frenchspacing\biburlsetup
   \lineskiplimit=-\maxdimen}% fixed 7.25bp leading, as in the original
  {\endlist\endgraf\tb@checkbackpage}
  {\item}
\endinput
